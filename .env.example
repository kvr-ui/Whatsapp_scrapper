# MongoDB Atlas connection string. The database name in the URI is the one used.
ENGINE_MONGO_URL="mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/Whatsapp-broadcast-leads?retryWrites=true&w=majority"

# Password for the dashboard login screen.
# LEAVE THIS UNSET to disable the login gate entirely — the console then opens
# to anyone with the URL, including every lead phone number and CSV export.
DASHBOARD_PASSWORD="change-me"

# Random string used to sign the dashboard session cookie.
# Generate with: openssl rand -hex 32
AUTH_SECRET="change-me-to-32-plus-random-bytes"

# Shared secret that authorises /api/cron/weekly.
# Vercel Cron sends this automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET="change-me"

# Optional, local development only: path to a Chromium binary.
# Ignored on Vercel, which uses the bundled @sparticuz/chromium build.
CHROME_PATH="/usr/bin/google-chrome"
